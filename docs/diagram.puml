@startuml kernel diagram
' skinparam linetype ortho

rectangle "Core" {
    rectangle "Drivers" {
        [PCI]
        [PIT]
        [VGA]
        [PS/2 Keyboard]
        [PS/2 Mouse]
    }

    rectangle "Core Functions" {
        [Virtual Threads]
        [Memory Manager]
        [Interrupts]
    }

    rectangle "Utilities" {
        [Vector]
        [Mutex]
        [Events]
        [Bitmap]
    }
}

[Virtual Threads] --> [Mutex]
[Virtual Threads] --> [Memory Manager]

[Memory Manager] --> [Bitmap]
[Memory Manager] --> [Mutex]

[Interrupts] ..> [Mutex]

[Drivers] --> [Interrupts]
[PCI] --> [Vector]
[PIT] --> [Vector]
[PIT] --> [Virtual Threads]
[VGA] --> [Memory Manager]
[PS/2 Keyboard] --> [Events]

[Events] --> [Mutex]
[Events] --> [Vector]
[Vector] --> [Mutex]

rectangle "Programs" {
    rectangle "Shell" {
        [Visual output]
        [Text Input]
    }
}

node "Compatibility Layer (Kernel API)" as CL {
}

Programs --> CL
CL --> Core

@enduml
