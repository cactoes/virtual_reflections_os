{
    "configurations": [
        {
            "name": "kernel",
            "compilerPath": "${env:LLVM_BIN_PATH}/clang.exe",
            "cStandard": "gnu11",
            "intelliSenseMode": "linux-gcc-x64",
            "includePath": [
                "${workspaceFolder}/src/kernel/include",
                "${workspaceFolder}/src/shared/include"
            ],
            "defines": [
                "KERNEL_VIRTUAL_BASE=0xFFFFF80000000000ull",
                "CPU_ARCHITECTURE=1",
                "GIT_COMMIT_HASH=\"dev\""
            ]
        }
    ],
    "version": 4
}