{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug (no compile)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/VirtualReflectionsOS.bin",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable OS ABI detection",
                    "text": "set osabi none"
                },
                {
                    "description": "Show backtrace on crash",
                    "text": "set confirm off"
                },
                {
                    "description": "Show the backtrace when crash occurs",
                    "text": "set pagination off"
                }
            ],
            "miDebuggerServerAddress": "localhost:1234",
            "showDisplayString": true,
            "preLaunchTask": "start qemu debug"
        },
