{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start QEMU",
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "qemu-system-x86_64",
                "-ArgumentList", "\"-cdrom ${workspaceFolder}/build/VirtualReflectionsOS.iso -drive format=raw,file=build/disk.vhd,id=disk,if=none -device ahci,id=ahci -device ide-hd,drive=disk,bus=ahci.0 -S -gdb tcp::1234\" -no-reboot -m 2G"
            ]
        },
        {
            "label": "Compile kernel",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--name",
                "VirtualReflectionsOS",
                "--rm",
                "-v",
                "${workspaceFolder}:/root/env",
                "virtual_reflections_os_buildenv"
            ],
        },
        {
            "label": "Compile kernel & Start QEMU",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Compile kernel",
                "Start QEMU"
            ]
        }
    ]
}