{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start qemu debug",
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "powershell",
                "-ArgumentList",
                "-File ./qemu_start.ps1 debug",
            ],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "start qemu",
            "type": "shell",
            "command": "./qemu_start.ps1",
            "options": {
                "statusbar": {
                    "label": "$(debug-start) Run",
                    "detail" : "run the os"
                }
            }
        },
        {
            "label": "build kernel",
            "type": "shell",
            "command": "./docker_build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "statusbar": {
                    "label": "$(settings-gear) Build",
                    "detail" : "build the kernel"
                }
            }
        },
        {
            "label": "build & run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build kernel",
                "start qemu",
            ],
            "options": {
                "statusbar": {
                    "label": "$(run-all) Build & Run",
                    "detail" : "build & run the os"
                }
            }
        },
        {
            "label": "build kernel & start qemu debug",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build kernel",
                "start qemu debug"
            ],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        }
    ]
}